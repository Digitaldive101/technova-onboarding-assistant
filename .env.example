# Application
APP_NAME=AI Employee Onboarding Assistant
APP_ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Fixed company knowledge base
DATA_DIRECTORY=data
CHROMA_DIRECTORY=chroma_db
COLLECTION_NAME=employee_onboarding_documents

# Local embedding and Ollama models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6
LLM_TEMPERATURE=0

# Retrieval and chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=5
SIMILARITY_SCORE_THRESHOLD=0.10

# Streamlit (set in the shell or deployment environment)
API_BASE_URL=http://localhost:8000
